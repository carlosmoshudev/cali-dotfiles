# Load every alias fragment in lexical order.
_load_zsh_aliases() {
  local alias_dir="$HOME/.dotfiles/zsh/aliases"
  local alias_file

  [[ -d "$alias_dir" ]] || return 0

  for alias_file in "$alias_dir"/*.zsh(N); do
    source "$alias_file"
  done
}

_load_zsh_aliases
unfunction _load_zsh_aliases
