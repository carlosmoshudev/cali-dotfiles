# Ignore missing aliases so interactive shells do not spam errors.
unalias cat bat grep ls l ll la lla l1 l1a lt lt1 lt2 lt3 lta ld ltd \
  lnew lold lbig lsmall lext lver lgit lgits lperm linode llinks lbytes \
  ldirsize labsdate lplain lstree lstack lmedia llogs lcompose lbroken \
  lempty lchanged lworld dfh du1 cls reload please .. ... .... ..... \
  composefiles srv server comics home media df du update upgradable ports \
  myip weather moshu-ipscan tcat dps dcps dcu dcd dcl ddf dtop jerr jf \
  2>/dev/null
