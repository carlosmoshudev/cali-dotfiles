# Fast directory jumps and workspace shortcuts.

alias ..='cd .. && ll'
alias ...='cd ../.. && ll'
alias ....='cd ../../.. && ll'
alias .....='cd ../../../.. && ll'

alias composefiles='cd /srv/containers/pro && clear && ll'
alias srv='cd /srv && clear && ll'
alias server='cd /srv && clear && ll'
alias comics='cd /srv/media/comics && clear && ll'
alias home='cd ~ && clear && ll'
alias media='cd /srv/media && clear && ll'
